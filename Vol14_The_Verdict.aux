\@writefile{toc}{\contentsline {chapter}{\numberline {9}The 24-Cell as an Orientation Lattice}{44}{chapter.9}\protected@file@percent }
\@writefile{lof}{\addvspace {10\p@ }}
\@writefile{lot}{\addvspace {10\p@ }}
\@writefile{toc}{\contentsline {section}{\numberline {9.1}What the 24-Cell Is}{44}{section.9.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {9.2}Two Spaces, One Polytope}{44}{section.9.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9.1}{\ignorespaces Two tests, one polytope, drawn schematically (the spheres are shown as circles). Ordinary 3D direction data is tested against the 24-cell's 3D shadow --- the 12 cuboctahedral axes on $S^2$. Rotational data, which naturally lives on $S^3$, is tested against the 24 vertices themselves. The engine never mixes the two, and every result is labelled with the space it was scored in.}}{45}{figure.9.1}\protected@file@percent }
