\@writefile{toc}{\contentsline {chapter}{\numberline {A}The Filter Ablation: What Each Guard Contributes to the Verdict}{65}{chapter.A}\protected@file@percent }
\@writefile{lof}{\addvspace {10\p@ }}
\@writefile{lot}{\addvspace {10\p@ }}
\@writefile{toc}{\contentsline {section}{\numberline {A.1}The Point of the Ablation}{65}{section.A.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {A.1}{\ignorespaces The three tunable guards and the always-on spine. The ablation toggles the top three; the scramble is read in every run.}}{66}{table.A.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {A.2}The Design}{66}{section.A.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {A.2}{\ignorespaces The $2^3$ factorial. The harness \texttt  {ablate\_2d.py} drives the real pipeline as a subprocess under each combination, with the scramble null on throughout, and tabulates the best-of-grid real-to-scramble ratio per lake.}}{66}{table.A.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {A.3}The Results}{66}{section.A.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {A.3}{\ignorespaces Period engine ablation. The best-of-grid ratio is identical in all eight combinations, to the precision reported. CS~=~common\_support, SF~=~scale\_flag, RG~=~resolution\_gate.}}{67}{table.A.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {A.4}{\ignorespaces Phase engine ablation. Every lake returns an identical ratio in all eight combinations. The planted lock survives (2.24); the correlation ridge, pure noise, single-axis artifact, and the real lake all sit at the floor --- and none of that depends on the tunable filters.}}{67}{table.A.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {A.1}{\ignorespaces Verdict invariance (period engine; the phase engine is identical in character). Every lake's best-of-grid ratio is a dead-flat line across all eight toggle combinations. The planted lock sits far above the \textsc  {survives} threshold; the nulls and the real lake sit at the floor; and nothing --- not a single guard, nor any compounding of them --- moves any line. The tunable filters do not change the verdict.}}{67}{figure.A.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {A.4}Finding 1 --- The Verdict Is Invariant; the Scramble Carries It}{68}{section.A.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {A.2}{\ignorespaces Why the filters cancel. The same filter $f$ is applied to the real lake and its scramble before the ratio is taken. A correction that multiplies the real peak also multiplies the scramble peak, so it divides out. The verdict is, by construction, robust to the tunable guards --- and determined by the scramble.}}{69}{figure.A.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {A.5}Finding 2 --- The Resolution Gate Governs Coverage, Not Verdict}{69}{section.A.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {A.5}{\ignorespaces The resolution gate's only effect is coverage. Turning it off scores every pair on the grid; the best-of-grid ratio is unchanged, because the pairs the gate removes were never going to win.}}{69}{table.A.5}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {A.6}Finding 3 --- The Honest Boundary: C and D Had Nothing to Bite On}{69}{section.A.6}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {A.7}What the Ablation Closes}{70}{section.A.7}\protected@file@percent }
\@writefile{toc}{\contentsline {chapter}{\numberline {B}Formal Verification with Lean: Certifying the Instrument}{72}{chapter.B}\protected@file@percent }
\@writefile{lof}{\addvspace {10\p@ }}
\@writefile{lot}{\addvspace {10\p@ }}
\@writefile{toc}{\contentsline {section}{\numberline {B.1}Why Formal Verification, and Why Now}{72}{section.B.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {B.2}The Firewall: Lean Certifies the Instrument, Not the Physics}{72}{section.B.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {B.1}{\ignorespaces The firewall. Everything on the left is a mathematical property of the instrument and is provable, in principle, with no data at all --- this is Lean's domain. Everything on the right is an empirical property of the world and is decided only by data and the nulls. Lean can never cross the wall, and the programme never lets ``verified'' pretend it has.}}{73}{figure.B.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {B.3}How Lean Works, Briefly}{73}{section.B.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {B.2}{\ignorespaces From claim to check. A prose claim becomes a precise Lean statement a human can read and agree is the right thing to prove; the proof is then reduced, through Mathlib, to steps a tiny fixed kernel verifies. If it compiles, the theorem holds. Reputation plays no part.}}{74}{figure.B.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {B.4}The Pre-Registered Target Theorems}{74}{section.B.4}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {B.5}The Shape of One Theorem}{75}{section.B.5}\protected@file@percent }
\@writefile{lol}{\contentsline {lstlisting}{\numberline {B.1}VL-2, the shape of it. Schematic Lean 4; Mathlib lemma names may need adjustment on first compile.}{76}{lstlisting.B.1}\protected@file@percent }
